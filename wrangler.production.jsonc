// Operator production config. Credentials are separate Cloudflare Worker secrets.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hiobuy-supplier-inquiry-demo",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://inquiry.demo.hiobuy.com",
    "HIOBUY_GATEWAY_ORIGIN": "https://api.hiobuy.com",
    "HIOBUY_APP_ID": "app_3e7f56973f47ee3e53303614",
    "HIOBUY_CHANNEL": "1688",
    "HIOBUY_PRODUCT_ID": "673124809943",
    "HIOBUY_PRODUCT_LANGUAGE": "en",
    "MEDIA_ENABLED": "images"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DEMO_STATE",
        "class_name": "DemoState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-demo-state",
      "new_sqlite_classes": [
        "DemoState"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "routes": [
    {
      "pattern": "inquiry.demo.hiobuy.com",
      "zone_name": "hiobuy.com",
      "custom_domain": true
    }
  ],
  "services": [
    {
      "binding": "HIOBUY_GATEWAY",
      "service": "hiobuy-api-gateway"
    }
  ]
}
