// Copy and edit for your own App/domain. Store credentials with Wrangler secrets.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "supplier-inquiry-demo-dev",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://inquiry-demo.example.com",
    "HIOBUY_GATEWAY_ORIGIN": "https://api.hiobuy.com",
    "HIOBUY_APP_ID": "app_replace_me",
    "HIOBUY_CHANNEL": "1688",
    "HIOBUY_PRODUCT_ID": "673124809943",
    "HIOBUY_PRODUCT_LANGUAGE": "en",
    "MEDIA_ENABLED": "false"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DEMO_STATE",
        "class_name": "DemoState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-demo-state",
      "new_sqlite_classes": [
        "DemoState"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
